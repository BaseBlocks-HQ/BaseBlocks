# Convex CLI selection. This file is local-only and is not copied to Vercel.
CONVEX_DEPLOYMENT=dev:your-deployment-name
CONVEX_URL=https://your-development.convex.cloud
CONVEX_SITE_URL=https://your-development.convex.site

# Better Auth origin and Convex HTTP actions
APP_URL=http://localhost:3001
SITE_URL=https://your-development.convex.site
BETTER_AUTH_SECRET=
OAUTH_PROXY_SECRET=

# Social login credentials for the selected environment
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Files SDK configuration used by Convex actions
FILES_ADAPTER=s3
FILES_BUCKET=
FILES_ENDPOINT=
FILES_REGION=auto
FILES_FORCE_PATH_STYLE=true
FILES_ACCESS_KEY_ID=
FILES_SECRET_ACCESS_KEY=
FILES_MAX_UPLOAD_SIZE_BYTES=104857600
EXTRACTION_API_URL=
EXTRACTION_API_SECRET=

# Billing and hosted AI
BASEBLOCKS_APP_ORIGIN=https://baseblocks-owner-preview.vercel.app
BASEBLOCKS_BILLING_ENVIRONMENT=sandbox
BASEBLOCKS_PAST_DUE_GRACE_DAYS=0
POLAR_ENVIRONMENT=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ALLOW_PRODUCTION=false
AI_RECONCILIATION_SECRET=

# Managed integration delivery
INTEGRATIONS_ENABLED=false
NANGO_API_KEY=
NANGO_WEBHOOK_SIGNING_KEY=
NANGO_API_BASE_URL=https://api.nango.dev
NANGO_NOTION_INTEGRATION_ID=notion
