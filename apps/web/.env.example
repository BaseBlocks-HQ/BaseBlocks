# Local web runtime
# In the normal workflow these values come from `vercel env pull` or
# `vercel env run -e development`; do not copy backend secrets here.
NEXT_PUBLIC_CONVEX_URL=https://your-development.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-development.convex.site
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Vercel-managed runtime configuration
BASEBLOCKS_AI_FUNDING_MODE=hosted-funded
BASEBLOCKS_BILLING_ENVIRONMENT=sandbox
EDITOR_AI_MODEL=openai/gpt-5.4-mini
CONVEX_DEPLOY_KEY=
VERCEL_OIDC_TOKEN=
CRON_SECRET=
AI_RECONCILIATION_SECRET=

# Optional server-only integrations used by the web app
VERCEL_ACCESS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
ANALYTICS_DATA_MODE=mock
GITHUB_TOKEN=

# Files SDK gateway/storage boundary
FILES_ADAPTER=s3
FILES_BUCKET=
FILES_ENDPOINT=
FILES_REGION=auto
FILES_FORCE_PATH_STYLE=true
FILES_ACCESS_KEY_ID=
FILES_SECRET_ACCESS_KEY=
FILES_MAX_UPLOAD_SIZE_BYTES=104857600
FILES_API_SECRET=
EXTRACTION_API_SECRET=
