# =============================================================================
# BaseBlocks Environment Variables
# =============================================================================
# Copy the relevant values to:
#   - apps/web/.env.local
#   - packages/backend/.env.local
# =============================================================================

# --- apps/web/.env.local ---

NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Hosted AI uses Vercel AI Gateway only after paid-credit admission succeeds.
# API keys take precedence over OIDC in the installed Gateway SDK; remove a
# stale AI_GATEWAY_API_KEY instead of expecting OIDC to override it.
BASEBLOCKS_AI_FUNDING_MODE=hosted-funded
BASEBLOCKS_BILLING_ENVIRONMENT=sandbox
EDITOR_AI_MODEL=provider/model
AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN is normally injected by Vercel; do not commit a value.
VERCEL_OIDC_TOKEN=
CRON_SECRET=
AI_RECONCILIATION_SECRET=

# Server-only Vercel SDK credentials for custom-domain lifecycle operations.
# Create a narrowly scoped team token; never prefix it with NEXT_PUBLIC_.
VERCEL_ACCESS_TOKEN=
VERCEL_PROJECT_ID=your-vercel-project-id
VERCEL_TEAM_ID=your-vercel-team-id

# Keep mock for development/preview. Enable live only after Vercel supports
# server-token access to the Web Analytics endpoint used by this feature.
ANALYTICS_DATA_MODE=mock

# Optional GitHub token used by product integrations.
GITHUB_TOKEN=

# Files SDK gateway/storage boundary.
FILES_ADAPTER=s3
FILES_BUCKET=user-content
FILES_ENDPOINT=
FILES_REGION=
FILES_FORCE_PATH_STYLE=true
FILES_ACCESS_KEY_ID=
FILES_SECRET_ACCESS_KEY=
FILES_MAX_UPLOAD_SIZE_BYTES=104857600
FILES_API_SECRET=

# Internal Convex -> Next extraction callback.
EXTRACTION_API_SECRET=

# --- packages/backend/.env.local ---

APP_URL=http://localhost:3001
SITE_URL=https://your-deployment.convex.site
CONVEX_DEPLOYMENT=dev:your-deployment-name
CONVEX_URL=https://your-deployment.convex.cloud

# Sandbox billing only. Use an HTTPS development origin/tunnel for Polar
# checkout and portal return URLs. Production additionally requires the
# explicit POLAR_ALLOW_PRODUCTION=true gate.
BASEBLOCKS_APP_ORIGIN=https://your-development-origin.example
BASEBLOCKS_BILLING_ENVIRONMENT=sandbox
BASEBLOCKS_PAST_DUE_GRACE_DAYS=0
POLAR_ENVIRONMENT=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ALLOW_PRODUCTION=false
AI_RECONCILIATION_SECRET=

BETTER_AUTH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

FILES_ADAPTER=s3
FILES_BUCKET=user-content
FILES_ENDPOINT=
FILES_REGION=
FILES_FORCE_PATH_STYLE=true
FILES_ACCESS_KEY_ID=
FILES_SECRET_ACCESS_KEY=
FILES_MAX_UPLOAD_SIZE_BYTES=104857600

EXTRACTION_API_URL=
EXTRACTION_API_SECRET=

# Managed integration auth and sync delivery (Nango Cloud or self-hosted).
# Configure the Nango webhook URL as:
#   https://your-deployment.convex.site/integrations/webhooks/nango
NANGO_API_KEY=
NANGO_WEBHOOK_SIGNING_KEY=
NANGO_API_BASE_URL=https://api.nango.dev
NANGO_NOTION_INTEGRATION_ID=notion
